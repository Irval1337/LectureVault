FROM node:24-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54 AS cli
RUN npm install --global --no-audit --no-fund @anthropic-ai/claude-code@2.1.314 @openai/codex@0.169.0

FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
COPY --from=cli /usr/local/bin/node /usr/local/bin/node
COPY --from=cli /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/@anthropic-ai/claude-code/bin/claude.exe /usr/local/bin/claude && ln -s /usr/local/lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex && groupadd -g 10001 lecturevault && useradd -u 10001 -g 10001 -m lecturevault && mkdir /profiles /work /secrets && chown 10001:10001 /profiles /work /secrets
COPY backend/requirements.lock /tmp/requirements.lock
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock
COPY runner/ /app/runner/
COPY backend/providers.py /app/backend/providers.py
COPY backend/__init__.py /app/backend/__init__.py
WORKDIR /work
ENV RUNNER_KIND=providers PYTHONPATH=/app
USER 10001:10001
RUN claude --version && codex --version
CMD ["python", "-m", "uvicorn", "runner.server:app", "--host", "0.0.0.0", "--port", "8090", "--no-access-log"]
