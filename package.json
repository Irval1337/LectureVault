{
  "name": "lecturevault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web --",
    "build": "npm run build --workspace web",
    "preview": "npm run preview --workspace web --",
    "test": "vitest run",
    "test:e2e": "python3 tests/run_e2e.py",
    "test:api": ".venv/bin/python -m pytest tests/test_api.py tests/test_runner.py -q"
  },
  "overrides": {
    "katex": "^0.19.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "vitest": "^4.0.0"
  }
}
