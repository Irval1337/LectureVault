# Development: local app and private local inbox, never exposed on 0.0.0.0.
LECTUREVAULT_PORT=5180
LECTUREVAULT_MAIL_PORT=8026
LV_PUBLIC_URL=http://localhost:5180
COMPOSE_BAKE=false

# Production: copy to a private .env.production and set/uncomment these values.
# docker compose --env-file .env.production -f compose.yaml -f compose.prod.yaml ...
# LV_DOMAIN=notes.example.com
# LV_ACME_EMAIL=operator@example.com
# LV_SUPPORT_EMAIL=support@example.com
# LV_SMTP_HOST=smtp.example.com
# LV_SMTP_PORT=587
# LV_SMTP_TLS=starttls
# LV_SMTP_USER=noreply@example.com
# LV_MAIL_FROM=LectureVault <noreply@example.com>
# SMTP password: use `python -m backend.manage smtp-password` in the API container.
# Never put CLI credentials or passwords in this file, arguments or source control.
